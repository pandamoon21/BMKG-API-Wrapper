# Copy to .env and fill in. bmkgaw reads these from the environment at import
# time (no dotenv loader — set them in the shell or a process manager).

# Token for the app API endpoints (auth-gated df/v1 + marine, host api-apps.bmkg.go.id). Take it from
# assets/flutter_assets/.env inside the Info BMKG APK (the API_LOCK= line).
# With or without the "Bearer " prefix — bmkgaw adds it automatically if it's
# missing.
# Example:  BMKGAW_TOKEN=Bearer <fill-in-API_LOCK-from-APK>
#
# IF LEFT EMPTY: endpoints with source=auto fall back to the public web source
# (open data, no token). Endpoints without a web equivalent (present, area,
# marine) return a 400 asking for a token. Keep the real token in .env / env
# vars — never commit it to git or hardcode it.
BMKGAW_TOKEN=

# Per-request source default can also be set via the ?source= query param:
#   auto (default)  : token set → app; no token → web (when available)
#   app             : force the app API (needs token)
#   web             : force public open data (no token)
# Examples:
#   /api/v1/weather/forecast?adm4=31.71.03.1001&source=web
#   /api/v1/weather/forecast?adm4=31.71.03.1001&source=app

# Agent name sent as x-agent-bmkg on auth requests (default infobmkg, the
# agent name in the app — leave as-is).
BMKGAW_AGENT=infobmkg

# Cache backend: memory (default) | sqlite
BMKGAW_CACHE_BACKEND=memory
# DSN when backend=sqlite (default sqlite:///bmkgaw_cache.db)
BMKGAW_CACHE_DB_URL=sqlite:///bmkgaw_cache.db
