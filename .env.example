# Copy to .env and fill in. bmkgaw reads these from the environment at import
# time (no dotenv loader — set them in the shell or a process manager).

# Token untuk endpoint API research (app df/v1 + marine). Ambil dari
# assets/flutter_assets/.env pada APK Info BMKG (baris API_LOCK=...).
# Isi dengan nilai API_LOCK (boleh dengan atau tanpa awalan "Bearer " —
# bmkgaw menambahkannya otomatis kalau belum ada).
# Contoh:  BMKGAW_TOKEN=Bearer <isi-dengan-API_LOCK-dari-APK>
#
# KALAU KOSONG: endpoint ber-source 'auto' akan otomatis fallback ke sumber
# web publik (open data, tanpa token). Endpoint tanpa padanan web (present,
# area, marine) akan error 400 minta token. Selalu tempatkan token asli di
# .env / env var — JANGAN commit ke git atau hardcode.
BMKGAW_TOKEN=

# Pilihan sumber default per-request bisa di-set lewat query param ?source=
#   auto (default)  : token ada → app; token kosong → web (kalau tersedia)
#   app             : paksa API research (butuh token)
#   web             : paksa open data publik (tanpa token)
# Contoh:
#   /api/v1/weather/forecast?adm4=31.71.03.1001&source=web
#   /api/v1/weather/forecast?adm4=31.71.03.1001&source=app

# Agent name dikirim sebagai x-agent-bmkg pada request auth (default infobmkg,
# nama agent di app — biarkan default).
BMKGAW_AGENT=infobmkg

# Cache backend: memory (default) | sqlite
BMKGAW_CACHE_BACKEND=memory
# DSN when backend=sqlite (default sqlite:///bmkgaw_cache.db)
BMKGAW_CACHE_DB_URL=sqlite:///bmkgaw_cache.db
